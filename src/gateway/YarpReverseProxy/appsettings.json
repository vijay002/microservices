{
	"Jwt": {
		"Key": "THIS_IS_A_DEmo_Secret_Key_APIGateway",
		"Issuer": "MicroservicesAuthServer",
		"Audience": "MicroservicesAuthServer",
		"ExpireMinutes": 60
	},
	"ReverseProxy": {
		"Routes": {
			"authRoute": {
				"ClusterId": "authCluster",
				"Match": {
					"Path": "/auths/{**catch-all}"
				},
				"Transforms": [
					{
						"PathPattern": "/{**catch-all}"
					}
				]
			},
			"orderRoute": {
				"ClusterId": "orderCluster",
				"Match": {
					"Path": "/orders/{**catch-all}"
				},
				"Transforms": [
					{
						"PathPattern": "/{**catch-all}"
					}
				]
			},
			"notificationRoute": {
				"ClusterId": "notificationCluster",
				"Match": {
					"Path": "/notification/{**catch-all}"
				},
				"Transforms": [
					{
						"PathPattern": "/{**catch-all}"
					}
				]
			}
		},
		"Clusters": {
			"authCluster": {
				"Destinations": {
					"d1": {
						"Address": "http://auth.api:8080/"
					}
				}
			},
			"orderCluster": {
				"Destinations": {
					"d1": {
						"Address": "http://ordering.api:8080/"
					}
				}
			},
			"notificationCluster": {
				"Destinations": {
					"d1": {
						"Address": "http://notification.api:8080/"
					}
				}
			}
		}
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*"
}